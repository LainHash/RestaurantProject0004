@using Restaurant.Blazor.DTOs.Catalog.Categoies
@using Restaurant.Blazor.Common.Constants

<!-- Food Category Start -->
<div class="food mt-0">
    <div class="container">
        <div class="row align-items-center">
            @if (IsLoading)
            {
                @for (int i = 0; i < 3; i++)
                {
                    <div class="col-md-4">
                        <div class="food-item placeholder-glow">
                            <i class="bi bi-egg-fried"></i>
                            <h2><span class="placeholder col-6"></span></h2>
                            <p><span class="placeholder col-10"></span></p>
                        </div>
                    </div>
                }
            }
            else
            {
                @foreach (var category in Categories.Take(3))
                {
                    var isActive = SelectedCategoryId == category.PublicId.ToString();
                    <div class="col-md-4">
                        <div class="food-item"
                             style="cursor: pointer"
                             role="button"
                             @onclick="() => OnCategorySelected.InvokeAsync(isActive ? null : category.PublicId.ToString())">
                            <i class="@category.Name.GetIcon()"></i>
                            <h2>@category.Name</h2>
                            <p>@category.Description</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
<!-- Food Category End -->
@code {
    [Parameter, EditorRequired]
    public List<CategoryVM> Categories { get; set; } = new();

    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>CategoryId được chọn (null = "Tất cả").</summary>
    [Parameter]
    public string? SelectedCategoryId { get; set; }

    /// <summary>Callback truyền CategoryId lên Menu.razor để gọi API.</summary>
    [Parameter]
    public EventCallback<string?> OnCategorySelected { get; set; }
}