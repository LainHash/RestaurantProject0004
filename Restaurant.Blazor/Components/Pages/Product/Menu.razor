@page "/Menu"
@layout MainLayout

@using Restaurant.Blazor.DTOs.Catalog.Products
@using Restaurant.Blazor.DTOs.Catalog.Categoies
@using Restaurant.Blazor.Services.Interfaces.Catalog
@using Restaurant.Blazor.Common.Models
@inject IProductApiService ProductService
@inject ICategoryApiService CategoryService
@inject IJSRuntime JS

<PageTitle>Burger King - Thực Đơn</PageTitle>

<PageHeader Title="Food Menu" />

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mx-3" role="alert">
        @errorMessage
    </div>
}

<_CategorySelection Categories="@categories"
                    IsLoading="@isLoading"
                    SelectedCategoryId="@query.CategoryId"
                    OnCategorySelected="OnFilterChanged" />

<_ProductGrid Products="@products"
              Categories="@categories"
              IsLoading="@isLoading"
              SelectedCategoryId="@query.CategoryId"
              OnCategorySelected="OnFilterChanged" />

@code {
    private List<ProductVM> products = new();
    private List<CategoryVM> categories = new();
    private bool isLoading = true;
    private ProductQuery query = new();

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            // Chạy song song 2 API call thay vì tuần tự → giảm thời gian chờ
            var categoriesTask = CategoryService.GetCategoiesAsync();
            var productsTask   = ProductService.GetProductsAsync(query);

            await Task.WhenAll(categoriesTask, productsTask);

            categories = categoriesTask.Result;
            products   = productsTask.Result;
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể tải danh sách sản phẩm. Vui lòng thử lại sau. ({ex.Message})";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Xử lý khi người dùng chọn / bỏ chọn category.
    /// categoryId = null → xem tất cả.
    /// </summary>
    private async Task OnFilterChanged(string? categoryId)
    {
        // Nếu click lại category đang chọn → reset
        query.CategoryId = categoryId;
        query.Page = 1;

        isLoading = true;
        errorMessage = null;
        StateHasChanged();          // cập nhật skeleton ngay lập tức

        try
        {
            products = await ProductService.GetProductsAsync(query);
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể lọc sản phẩm. Vui lòng thử lại sau. ({ex.Message})";
        }
        finally
        {
            isLoading = false;
        }

        // Scroll sau khi UI đã render xong — tách riêng để lỗi JS không ảnh hưởng filter
        try
        {
            await Task.Delay(150); // chờ Blazor render lại DOM
            await JS.InvokeVoidAsync("scrollToElement", "product-grid", 80);
        }
        catch
        {
            // Bỏ qua nếu JS chưa sẵn sàng
        }
    }
}


