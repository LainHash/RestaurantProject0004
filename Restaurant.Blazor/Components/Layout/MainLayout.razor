<!-- Footer End -->

<a href="#" class="back-to-top"><i class="fa fa-chevron-up"></i></a>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Đợi Blazor render xong DOM mới rồi mới init lại JS
        await Task.Delay(100);
        try
        {
            await JS.InvokeVoidAsync("reinitPage");
        }
        catch { /* Bỏ qua nếu page đã bị dispose trước khi JS chạy xong */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Gọi reinitPage khi lần đầu render (bổ sung cho main.js đã chạy)
            await Task.Delay(200);
            try
            {
                await JS.InvokeVoidAsync("reinitPage");
            }
            catch { }
        }
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
}
